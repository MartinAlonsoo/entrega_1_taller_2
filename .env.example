# Variables de entorno para deploy y frontend
# Copiar este archivo como .env y completar los valores

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

PRIVATE_KEY=private_key_Signer1_sin_0x
PRIVATE_KEY_2=private_key_Signer2_sin_0x

SIGNERS=AddressSigner1,AddressSigner2

# Umbral de aprobaciones necesarias para MultiSig
THRESHOLD=2

# Entrega 2 - MultiSig
# Direccion publica del contrato MultiSig desplegado.
VITE_MULTISIG_ADDRESS=0xDireccionDelMultiSig

# Alias legacy usado por el frontend actual de Entrega 2.
# Mantener igual a VITE_MULTISIG_ADDRESS mientras exista codigo que lo lea.
VITE_CONTRACT_ADDRESS=0xDireccionDelMultiSig

# Entrega 3 - Marketplace
# Si se completa con un ERC-20 existente, deployMarketplace usara ese token.
# Si se deja vacio o como placeholder, deployMarketplace desplegara MockERC20.
PAYMENT_TOKEN_ADDRESS=0xDireccionDelTokenERC20

# Solo aplica cuando deployMarketplace despliega MockERC20.
MOCK_TOKEN_INITIAL_SUPPLY=1000000

# Direcciones que debe consumir el frontend de Entrega 3.
VITE_MARKETPLACE_ADDRESS=0xDireccionDelJobMarketplace
VITE_PAYMENT_TOKEN_ADDRESS=0xDireccionDelTokenERC20
